# Only secret the pipeline needs. Copy to .env and fill in.
OPENAI_API_KEY=

# Optional model overrides (defaults shown).
SOP_SYNTH_MODEL=gpt-5.1
SOP_EXTRACT_MODEL=gpt-5.1
SOP_JUDGE_MODEL=gpt-5.1
# Final `evaluate` grader only — kept separate from SOP_JUDGE_MODEL (which the generator's
# gap-audit uses) because a stronger model here grades more reliably but prunes recall there.
SOP_EVAL_MODEL=gpt-4.1

# Model used to extract facts from transcript + frames of a video.
SOP_VIDEO_MODEL=gpt-5.1
# Model used to extract transcript from audio
SOP_TRANSCRIBE_MODEL=whisper-1
# Optional path to a YAML file overriding a subset of src/sop_pipeline/video/config.yaml's
# keys (strategy choice, frame/chunk knobs, ...). Unset uses the checked-in defaults.
# SOP_VIDEO_CONFIG=/path/to/my_custom_config.yaml

# Optional Section 1 document-control metadata (defaults shown / used when unset).
# SOP_RUN_DATE defaults to today's date.
SOP_AUTHOR=Marvik
# SOP_VERSION=0.1 (draft)
# SOP_STATUS=Draft
# Customer/organization name for the SOP front matter "Prepared for" field.
SOP_TARGET_CUSTOMER=MyAwesomeCompany
